{
  "name": "dinner-midpoint",
  "private": true,
  "description": "Where To Eat Ah? Static front end plus a small Vercel API. Dev tooling is never shipped to the browser.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint .",
    "lint:css": "stylelint style.css",
    "lint:html": "html-validate index.html",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node tools/build-site.mjs",
    "check:site": "node tools/check-site.mjs _site",
    "test": "node --test \"tests/*.test.mjs\"",
    "e2e": "playwright test",
    "dev": "node tools/dev-server.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "html-validate": "11.21.1",
    "leaflet": "1.9.4",
    "prettier": "3.10.1",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.1"
  }
}
